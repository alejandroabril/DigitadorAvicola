# Volcados de memoria (heap dumps) de crashes OOM
*.hprof

# Carpetas de build generadas
/build
/app/build

# Gradle
/.gradle
.kotlin

# IntelliJ IDEA / Android Studio
# Se ignora la carpeta completa salvo los archivos que el equipo quiera versionar.
# Para versionar uno concreto, descomenta y ajusta, p. ej.:
#   !/.idea/codeStyles
#   !/.idea/runConfigurations
/.idea

# Configuración local del entorno (rutas del SDK, claves, etc.)
local.properties

# Claves de firma (NUNCA subir a un repositorio)
*.jks
*.keystore
# Ruta y contraseñas del keystore de release (ver app/build.gradle.kts)
keystore.properties

# Estado local de Claude Code / herramientas del entorno
/.claude

# ── Archivos que NO son parte de la app (datos de ejemplo, mockups, scripts dev) ──
# Se mantienen en el disco local pero NO se versionan: el repo es solo la app.
/*.davi
/*.csv
/*.xlsx
/*.ico
/*.html
/Lote_Prueba_6_Semanas.json
/PROMPT_DAVI.md
/gen_davi.py
/imagen inicio.png
/Experimental/

# Toolchain del daemon que genera Android Studio: clava el JDK del equipo
# local (hoy 25) y no debe imponerse a quien clone el repo.
/gradle/gradle-daemon-jvm.properties
